{
  "mcpServers": {
    "git": {
      "command": "git",
      "args": ["--version"],
      "description": "Local Git access for repository operations"
    },
    "confluence": {
      "command": "confluence-mcp-server",
      "args": ["--url", "${CONFLUENCE_URL}"],
      "env": {
        "CONFLUENCE_URL": "${CONFLUENCE_URL}",
        "CONFLUENCE_API_TOKEN": "${CONFLUENCE_API_TOKEN}",
        "CONFLUENCE_EMAIL": "${CONFLUENCE_EMAIL}"
      },
      "description": "Confluence access for requirement retrieval"
    },
    "github": {
      "command": "gh",
      "args": ["auth", "status"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "GitHub access using a token from the environment or credential manager"
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "description": "Playwright automation and browser testing"
    },
    "selenium": {
      "command": "java",
      "args": ["-jar", "selenium-server.jar"],
      "env": {
        "SELENIUM_SERVER_JAR": "C:\\path\\to\\selenium-server.jar"
      },
      "description": "Selenium browser automation server"
    },
    "jira": {
      "command": "jira-mcp-server",
      "args": ["--url", "${JIRA_URL}"],
      "env": {
        "JIRA_URL": "${JIRA_URL}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
        "JIRA_EMAIL": "${JIRA_EMAIL}",
        "JIRA_PROJECT_KEY": "${JIRA_PROJECT_KEY}"
      },
      "description": "Jira access for story and task creation from requirements",
      "connectionCheck": {
        "endpoint": "${JIRA_URL}/rest/api/3/myself",
        "authHeader": "Basic base64(${JIRA_EMAIL}:${JIRA_API_TOKEN})",
        "expectedStatus": 200
      }
    },
    "gitlab": {
      "command": "gitlab-mcp-server",
      "args": ["--url", "${GITLAB_URL}"],
      "env": {
        "GITLAB_URL": "${GITLAB_URL}",
        "GITLAB_TOKEN": "${GITLAB_TOKEN}",
        "GITLAB_PROJECT_ID": "${GITLAB_PROJECT_ID}",
        "GITLAB_PROJECT_PATH": "${GITLAB_PROJECT_PATH}",
        "GITLAB_DEFAULT_BRANCH": "${GITLAB_DEFAULT_BRANCH}"
      },
      "description": "GitLab access for publishing project plan (wiki + repository commit)",
      "connectionCheck": {
        "endpoint": "${GITLAB_URL}/api/v4/user",
        "authHeader": "PRIVATE-TOKEN: ${GITLAB_TOKEN}",
        "expectedStatus": 200
      }
    }
  }
}
