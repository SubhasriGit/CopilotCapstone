CONFLUENCE_URL=https://your-confluence-url-here
CONFLUENCE_API_TOKEN=replace-me
CONFLUENCE_EMAIL=replace-me
GITHUB_TOKEN=replace-me

# Jira Integration
JIRA_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=replace-me
JIRA_EMAIL=replace-me
JIRA_PROJECT_KEY=replace-me

# Render Deployment
RENDER_DEPLOY_HOOK_URL=replace-me
RENDER_API_KEY=replace-me
RENDER_SERVICE_ID=replace-me
