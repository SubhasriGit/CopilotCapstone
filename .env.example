# GitLab Integration (used by PlanningAgent to publish the project plan)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=replace-me
GITLAB_PROJECT_ID=replace-me
GITLAB_PROJECT_PATH=replace-me/replace-me
GITLAB_DEFAULT_BRANCH=main

DB_URL=jdbc:h2:mem:capstonedb
DB_USERNAME=sa
DB_PASSWORD=replace-me
EXTERNAL_API_URL=https://api.example.com
EXTERNAL_API_KEY=replace-me
APP_PORT=8080
APP_ENV=local
