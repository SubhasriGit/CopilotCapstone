#!/bin/sh
# pre-commit-secrets: Scans staged files for hardcoded secrets.
# Blocks the commit if any secret pattern is found.

set -e

if [ "${SKIP_SECRET_CHECK}" = "true" ]; then
    echo "⚠️  WARNING: Secret check skipped (SKIP_SECRET_CHECK=true). This must be justified and approved."
    exit 0
fi

echo "🔍 Running secret detection scan on staged files..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -v "^.github/hooks/" || true)

if [ -z "$STAGED_FILES" ]; then
    echo "✅ No staged files to scan."
    exit 0
fi

FOUND_SECRET=0

# Secret patterns to detect
PATTERNS='password\s*=\s*["'"'"'][^"'"'"']+["'"'"']
api[_-]?key\s*=\s*["'"'"'][^"'"'"']+["'"'"']
secret\s*=\s*["'"'"'][^"'"'"']+["'"'"']
token\s*=\s*["'"'"'][^"'"'"']+["'"'"']
ghp_[A-Za-z0-9]{36}
sk-[A-Za-z0-9]{48}
[A-Z0-9]{20}[A-Z0-9]+
-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY'

for FILE in $STAGED_FILES; do
    if [ ! -f "$FILE" ]; then continue; fi

    while IFS= read -r PATTERN; do
        if git show ":$FILE" 2>/dev/null | grep -iEq "$PATTERN"; then
            echo ""
            echo "❌ ERROR: Potential hardcoded secret detected!"
            echo "   File   : $FILE"
            echo "   Pattern: $PATTERN"
            echo ""
            echo "   👉 Remove the secret and use environment variables instead."
            echo "   👉 Example: String apiKey = System.getenv(\"API_KEY\");"
            echo ""
            FOUND_SECRET=1
        fi
    done <<EOF
$PATTERNS
EOF
done

if [ "$FOUND_SECRET" -eq 1 ]; then
    echo "🚫 Commit blocked. Fix all secret violations before committing."
    echo "   To bypass in an emergency (team lead approval required): SKIP_SECRET_CHECK=true git commit"
    exit 1
fi

echo "✅ Secret scan passed. No hardcoded secrets detected."
exit 0
